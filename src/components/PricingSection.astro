---
import Check from "../assets/theme-images/icon-check.svg";
import Cube from "../assets/theme-images/icon-cube.svg";
import CubeOutline from "../assets/theme-images/icon-cube-outline.svg";

const { title, pricing } = Astro.props;
---

<section class="bs-container bs-mt-lg" id="pricing">
  <!-- Header -->
  {title && <h2 class="bs-h2 text-center">{title}</h2>}

  <div class="flex flex-row my-15 gap-x-5">
    <div class="flex flex-col basis-1/2 p-5 gap-y-5">
      <h3 class="bs-h3">Somos Una startup que impulsa soluciones reales</h3>
      <p>
        En Smash Solutions combinamos creatividad, tecnología y experiencia para
        construir herramientas digitales a la medida. Nacimos con la idea de
        ayudar a personas y pequeñas empresas a dar el salto al mundo digital
        con productos bien hechos, funcionales y rápidos.
      </p>
    </div>
    <div class="basis-1/2 p-5">
      <p>contenido de imagen</p>
    </div>
  </div>
</section>
