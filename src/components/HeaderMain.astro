---
import Logo from "../assets/theme-images/logo.svg";
import logoImg from "../assets/theme-images/logoSSv4.png";
import { Image } from "astro:assets";

const { settings } = Astro.props;
---

<header class="wrapper bg-loop font-semibold">
  <!-- Wrapper -->
  <div class="bs-container py-6 flex justify-between items-center">
    <!-- Logo -->
    <a
      class="flex xl:min-w-32 group"
      href="/"
      aria-label={settings.title + " - Home"}
    >
      <Image src={logoImg} alt="Logo" height="100" width="150" />
    </a>

    <!-- Nav -->
    <nav
      class="hidden col-span-6 md:flex mx-auto self-stretch lg:gap-2 items-center"
    >
      <!-- Links -->
      {
        settings.nav.map((item) => (
          <a
            class="bs-btn !bg-transparent before:translate-y-full hover:before:translate-y-0"
            href={item.link}
          >
            {item.title}
          </a>
        ))
      }
    </nav>

    <!-- CTA -->
    <button type="button" class="min-w-32 bs-btn" onclick="demo.showModal()">
      {settings.demo.title}
    </button>
  </div>
</header>
